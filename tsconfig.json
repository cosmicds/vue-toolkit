{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "composite": true,
    "strict": true,
    "declaration": true,
    "jsx": "preserve",
    "importHelpers": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "tslib": ["../node_modules/tslib/tslib.d.ts"]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "es2017"
    ]
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.vue"
  ],
}
