{
  "name": "@cosmicds/vue-toolkit",
  "browser": "dist/vue-toolkit.umd.js",
  "dependencies": {
    "@capacitor/core": "^5.7.4",
    "@capacitor/geolocation": "^5.0.7",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@kyvg/vue3-notification": "^2.9.1",
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^13.1.0",
    "@wwtelescope/engine": "^7.41.0",
    "@wwtelescope/engine-pinia": "^0.17.0",
    "leaflet": "^1.9.4",
    "pinia": "^2.1.7",
    "screenfull": "^6.0.2",
    "vue": "^3.5.0",
    "vuetify": "^3.3.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/test": "8.6.15",
    "@storybook/vue3": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^30",
    "@types/leaflet": "^1.9.11",
    "@types/node": "^26.4.0",
    "@types/prismjs": "^1.26.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.1",
    "@vue/compiler-sfc": "^3.4.25",
    "@wdns/vue-code-block": "^2.3.5",
    "eslint": "^10.9.1",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "less": "^4.2.0",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.63.0",
    "prismjs": "^1.30.0",
    "pug": "^3.0.3",
    "rimraf": "^6.1.3",
    "shepherd.js": "^15.2.2",
    "storybook": "^10.5.10",
    "storybook-css-modules-preset": "^1.1.1",
    "storybook-dark-mode": "^5.0.0",
    "typedoc": "^0.28",
    "typedoc-plugin-markdown": "^4",
    "typedoc-plugin-vue": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-shepherd": "^6.0.0",
    "vue-template-compiler": "^2.7.14",
    "vue-tsc": "^3.3.11"
  },
  "files": [
    "dist/*",
    "src/*"
  ],
  "main": "./dist/vue-toolkit.cjs.js",
  "module": "dist/vue-toolkit.es.js",
  "packageManager": "yarn@4.12.0",
  "publicConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vue-tsc --noEmit && vite build",
    "watch-build": "vite build --watch --mode watch",
    "watch-types": "vue-tsc -p tsconfig.watch.json --watch --preserveWatchOutput",
    "build-watch": "run-p watch-build watch-types",
    "clean": "rimraf dist",
    "docs": "typedoc --plugin typedoc-plugin-markdown",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006 --debug",
    "build-storybook": "storybook build -o docs",
    "test": "vitest",
    "test-unit": "vitest run --project unit",
    "test-storybook": "vitest run --project storybook"
  },
  "types": "./dist/src/index.d.ts",
  "version": "0.0.0-dev.0",
  "peerDependencies": {
    "@floating-ui/dom": "*",
    "shepherd.js": "*",
    "vue-shepherd": "*"
  }
}
